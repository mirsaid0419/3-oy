# Database Configuration
DB_PORT=5432
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=youtube_db
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=3000

# Admin Configuration
SUPER_ADMIN_USER_NAME=admin
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_ROLL=superadmin

# JWT Tokens
ACCES_TOKEN_KEY=your_access_token_secret_key_here
ACCES_TOKEN_TIME=15m
REFRESH_TOKEN_KEY=your_refresh_token_secret_key_here
REFRESH_TOKEN_TIME=7d

# Cookie Configuration
RESPONS_COOKIE_KEY=refreshToken
RESPONS_COOKIE_TIME=7

# Email Configuration (Nodemailer)
# Service type: gmail, outlook, yahoo, custom
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
# Gmail uchun App Password kerak: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=YouTube Clone

# Custom SMTP Configuration (agar EMAIL_SERVICE=custom bo'lsa)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Resend API Key (Optional - Nodemailer o'rniga)
# Get your API key from: https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here
